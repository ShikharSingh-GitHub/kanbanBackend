# Backend env example for Firestore
# Provide a Firebase service account JSON (stringified) or a path to the JSON file.
# Option A: paste JSON string (recommended for Vercel environment variable)
# FIREBASE_SERVICE_ACCOUNT={...}

# Option B: provide a path to a JSON file checked into the server (not recommended)
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Frontend URL (used for CORS)
FRONTEND_URL=https://kanban-frontend-pi.vercel.app

# (If you still want to use Mongo locally for dev, set MONGO_URI)
# MONGO_URI=mongodb://127.0.0.1:27017/kanban
